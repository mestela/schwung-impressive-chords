{
  "id": "impressive-chords",
  "name": "Impressive Chords",
  "description": "Advanced chord generator with strumming and clock-synced retriggering",
  "version": "0.1.24",
  "author": "mestela",
  "capabilities": {
    "chainable": true,
    "component_type": "midi_fx",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "Impressive Chords",
          "count_param": "preset_count",
          "list_param": "preset_index",
          "name_param": "preset_name",
          "params": [
            {
              "key": "preset_index",
              "name": "Preset",
              "type": "int",
              "min": 0,
              "max": 500,
              "default": 0
            },
            {
              "key": "base_note",
              "short_name": "Note",
              "name": "Base Note",
              "type": "int",
              "min": 0,
              "max": 127,
              "default": 48,
              "step": 1
            },
            {
              "key": "transpose",
              "name": "Transpose",
              "type": "int",
              "min": -24,
              "max": 24,
              "default": 0,
              "step": 1
            },
            {
              "key": "invert",
              "name": "Invert",
              "type": "int",
              "min": -12,
              "max": 12,
              "default": 0,
              "step": 1
            },
            {
              "key": "strum",
              "name": "Strum",
              "type": "int",
              "min": 0,
              "max": 100,
              "default": 0,
              "step": 1
            },
            {
              "key": "tilt",
              "name": "Tilt",
              "type": "int",
              "min": -100,
              "max": 100,
              "default": 0,
              "step": 1
            },
            {
              "key": "articulate",
              "name": "Articulate",
              "type": "int",
              "min": 1,
              "max": 8,
              "default": 1,
              "step": 1
            },
            {
              "key": "length",
              "name": "Length",
              "type": "int",
              "min": 10,
              "max": 2000,
              "default": 200,
              "step": 10
            },
            {
              "key": "retrig",
              "name": "Retrigger",
              "type": "enum",
              "options": [
                "0 Off",
                "1 1B",
                "2 1/2B",
                "3 1b",
                "4 1/2b",
                "5 1/4b",
                "6 1/8b",
                "7 1/16b",
                "8 1/32b"
              ],
              "default": 0
            },
            {
              "key": "timing",
              "name": "Timing",
              "type": "enum",
              "options": [
                "Straight",
                "Dotted",
                "Triplet"
              ],
              "default": 0
            },
            {
              "key": "choke",
              "name": "Choke",
              "type": "int",
              "min": 0,
              "max": 1,
              "default": 0
            },
            {
              "key": "notes",
              "short_name": "Limit",
              "name": "Notes Limit",
              "type": "int",
              "min": 0,
              "max": 12,
              "default": 0
            },
            {
              "key": "fit",
              "short_name": "Strum",
              "name": "Fit Strum",
              "type": "int",
              "min": 0,
              "max": 1,
              "default": 0
            },
            {
              "key": "gate",
              "name": "Gate",
              "type": "int",
              "min": 0,
              "max": 1,
              "default": 0
            },
            {
              "key": "scan",
              "short_name": "Presets",
              "name": "Scan Presets",
              "type": "int",
              "min": 0,
              "max": 1,
              "default": 0
            }
          ],
          "knobs": [
            "preset_index",
            "base_note",
            "transpose",
            "invert",
            "strum",
            "tilt",
            "articulate",
            "length",
            "retrig",
            "timing",
            "choke",
            "notes",
            "fit",
            "gate",
            "scan"
          ]
        }
      }
    }
  }
}